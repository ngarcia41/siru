# SIRU — variables de entorno
# Copiá este archivo como ".env" (sin ".example") y completá los valores.

# Conexión a PostgreSQL con PostGIS.
# Formato: postgresql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE
# Con la instalación estándar de Windows el usuario es "postgres" y la
# contraseña es la que elegiste al instalar PostgreSQL.
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/siru

# Base aislada para las pruebas (npm run prueba). Tiene que llamarse siru_prueba.
DATABASE_URL_PRUEBA=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/siru_prueba

# Secreto para firmar los tokens de sesión: al menos 32 caracteres al azar.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESION_SECRETO=reemplazar-por-un-valor-aleatorio-de-al-menos-32-caracteres

# "consola": el enlace de verificación de correo se muestra en la terminal y
# en la pantalla de registro (no se envían correos reales).
MODO_CORREO=consola

# Precisión GPS máxima aceptada, en metros. El documento fija 25.
# Para probar desde la computadora (ubicación por IP, poco precisa) podés
# subirla temporalmente, por ejemplo a 5000, y volver a 25 para la demo.
NEXT_PUBLIC_PRECISION_GPS_MAXIMA=25
